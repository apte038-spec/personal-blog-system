# 该文件仅用于说明项目需要的环境变量。
# Spring Boot 默认不会自动读取根目录 .env 文件，请在终端、IDE 或操作系统中设置变量。
# 复制为本地 .env 也不会自动生效，且真实 .env 已被 .gitignore 排除。

# Server
SERVER_PORT=8080

# MySQL 8
DB_URL=jdbc:mysql://localhost:3306/personal_blog?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=YOUR_DB_PASSWORD

# JWT（必须替换为仅供本机使用的安全随机值）
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRATION_HOURS=24

# SMTP（需要启用邮箱验证码功能时填写）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_SSL_ENABLE=true
SMTP_STARTTLS_ENABLE=false

# Runtime uploads
AVATAR_UPLOAD_DIR=uploads/avatars
