# Node.js / Vue / Vite
node_modules/
dist/
.npm-cache/
.vite/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java / Maven
target/
.m2/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Runtime logs and temporary files
*.log
logs/
*.pid
*.tmp
*.temp
*.swp
*.swo
*~

# Local environment and machine-specific configuration
.env
.env.*
!.env.example
!**/.env.example
application-local.yml
application-local.yaml
application-local.properties
application-dev-local.yml
application-dev-local.yaml
application-dev-local.properties

# Secrets, keys and certificates
secrets/
.secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer

# Runtime uploads: keep the directory, never commit user files
blog-server/uploads/*
!blog-server/uploads/.gitkeep

# IDE settings
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# Operating system files
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Test and coverage output
coverage/
.nyc_output/
test-results/
playwright-report/
